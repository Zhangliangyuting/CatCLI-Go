# Copy this file to .env and fill in your own values.

CATCLI_OPENAI_COMPATIBLE_API_KEY=your-api-key
CATCLI_OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
CATCLI_OPENAI_COMPATIBLE_MODEL=deepseek-v4-pro

# Local embedding service (requires the container in compose.embedding.yaml).
CATCLI_EMBEDDING_MODEL=bge-m3
CATCLI_EMBEDDING_BASE_URL=http://localhost:11435/v1
# Ollama ignores this placeholder; the client requires a non-empty key.
CATCLI_EMBEDDING_API_KEY=ollama
